{
  "name": "bunker-crm",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migration:new": "node scripts/db-new-migration.js",
    "db:migration:up": "supabase migration up",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:status": "supabase migration list",
    "db:seed": "node prisma/seed.js",
    "auth:provision": "node prisma/provision-users.js",
    "test:auth": "node tests/auth-suite.js",
    "test:leads": "node tests/leads-suite.js",
    "test:audit": "node tests/audit-suite.js",
    "test:clients": "node tests/clients-suite.js",
    "test:portal": "node tests/two-role-architecture-suite.js",
    "test:campaigns": "node tests/campaigns-suite.js",
    "test:reports": "node tests/reports-search-suite.js",
    "test:meta-leads": "node tests/meta-leads-suite.js",
    "test:meta-lead-fields": "node --experimental-strip-types --no-warnings --test tests/meta-lead-fields.test.mjs",
    "test:sms-template": "node --experimental-strip-types --no-warnings --test tests/sms-template.test.mjs",
    "test:sms-rule-selection": "node --experimental-strip-types --no-warnings --test tests/sms-rule-selection.test.mjs",
    "test:meta-webhook": "node --experimental-strip-types --no-warnings --test tests/meta-webhook.test.mjs",
    "test:automations": "node tests/automations-suite.js",
    "test:twilio-webhook": "node --experimental-strip-types --no-warnings --test tests/twilio-webhook.test.mjs",
    "test:sms-inbound": "node tests/sms-inbound-suite.js",
    "test:twilio-voice": "node --experimental-strip-types --no-warnings --test tests/twilio-voice.test.mjs",
    "test:voice-policy": "node --experimental-strip-types --no-warnings --test tests/voice-policy.test.mjs",
    "test:task-rules": "node --experimental-strip-types --no-warnings --test tests/task-rules.test.mjs",
    "test:calls": "node tests/calls-suite.js",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "@supabase/supabase-js": "^2.117.3",
    "@twilio/voice-sdk": "2.18.5",
    "@types/pg": "^8.23.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "supabase": "2.120.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.5.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "node -e \"require('child_process').execSync('tsc --noEmit', {stdio: 'inherit'})\""
    ]
  }
}
