{
  "name": "bunker-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "db:push": "prisma db push && pnpm db:secure",
    "db:secure": "prisma db execute --file prisma/supabase-rls.sql --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "auth:provision": "node prisma/provision-users.js",
    "test:auth": "node tests/auth-suite.js",
    "test:leads": "node tests/leads-suite.js",
    "test:audit": "node tests/audit-suite.js",
    "test:clients": "node tests/clients-suite.js",
    "test:portal": "node tests/two-role-architecture-suite.js",
    "test:campaigns": "node tests/campaigns-suite.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "@supabase/supabase-js": "^2.117.3",
    "@types/pg": "^8.23.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.5.0"
}
