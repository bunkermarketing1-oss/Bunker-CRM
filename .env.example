# Bunker Agency CRM - Environment Variables

# App Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase Official Project
NEXT_PUBLIC_SUPABASE_URL="https://exhwropgwwaeybzfeyei.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_O3AK5OjWHTXGqXMmgliykg_PeZvLvQV"

# Supabase service role (solo servidor: creación de usuarios en Supabase Auth). NUNCA con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=""

# Database: PostgreSQL de Supabase (el esquema es provider "postgresql"; SQLite no es compatible)
# - App en Dokploy (servidor persistente): conexión directa o Session pooler (puerto 5432)
# - Si se usa el Transaction pooler (puerto 6543) añadir ?pgbouncer=true&connection_limit=1
# Tras `pnpm db:push` se ejecuta `pnpm db:secure` (prisma/supabase-rls.sql) para cerrar la Data API.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.exhwropgwwaeybzfeyei.supabase.co:5432/postgres"

# Authentication Secret
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# SMS Messaging Provider (Twilio Example)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Cifrado de tokens OAuth de terceros guardados en BD (generar con: openssl rand -base64 32)
INTEGRATIONS_ENCRYPTION_KEY=""

# Secreto para el cron de sincronización (POST /api/cron/sync-campaigns con "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""

# Meta Integrations (Facebook Pages / Instagram / Ads)
# Redirect URI OAuth a registrar en la app de Meta: <NEXT_PUBLIC_APP_URL>/api/integrations/meta/callback
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"

# TikTok for Business
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# Google Ads API
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# AI Engine
AI_API_KEY=""
