# Bunker Agency CRM - Environment Variables

# App Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase Official Project
NEXT_PUBLIC_SUPABASE_URL="https://exhwropgwwaeybzfeyei.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_O3AK5OjWHTXGqXMmgliykg_PeZvLvQV"

# Supabase service role (solo servidor: creación de usuarios en Supabase Auth). NUNCA con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=""

# Database: PostgreSQL de Supabase (el esquema es provider "postgresql"; SQLite no es compatible)
# - App en Dokploy (servidor persistente): conexión directa o Session pooler (puerto 5432)
# - Si se usa el Transaction pooler (puerto 6543) añadir ?pgbouncer=true&connection_limit=1
# El esquema se gestiona con migraciones de Supabase (supabase/migrations). Ver README > Base de datos.
# - El pooler en modo sesión admite 15 clientes: src/lib/prisma.ts usa connection_limit=5 si la URL no lo define.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.exhwropgwwaeybzfeyei.supabase.co:5432/postgres"

# Authentication Secret
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# SMS Messaging Provider (Twilio Example)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Llamadas desde el navegador: Twilio Console > Account > API keys, y Voice > TwiML Apps
# (Voice URL: <NEXT_PUBLIC_APP_URL>/api/integrations/twilio/voice, método POST).
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_TWIML_APP_SID=""
# Antifraude de llamadas salientes: países (ISO alfa-2, separados por coma) a los que se
# puede llamar. Vacío = MX,CO,US. Además, limita los mismos países en Twilio Console >
# Voice > Settings > Geo Permissions: es la barrera que no depende del código.
VOICE_ALLOWED_COUNTRIES="MX,CO,US"

# Cifrado de tokens OAuth de terceros guardados en BD (generar con: openssl rand -base64 32)
INTEGRATIONS_ENCRYPTION_KEY=""

# Secreto para el cron de sincronización (POST /api/cron/sync-campaigns con "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""

# Meta Integrations (Facebook Pages / Instagram / Ads)
# Redirect URI OAuth a registrar en la app de Meta: <NEXT_PUBLIC_APP_URL>/api/integrations/meta/callback
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"
# Cadena aleatoria; la misma va en la app de Meta > Webhooks > Page > Verify token.
META_WEBHOOK_VERIFY_TOKEN=""

# TikTok for Business
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# Google Ads API
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# Asistente de IA fuera de horario (OpenAI). Responde los SMS de los leads cuando el
# cliente lo activa en su ficha. Sin clave solo se envía el mensaje de traspaso.
AI_API_KEY=""
# Opcional: modelo de OpenAI (por defecto gpt-4.1-mini). Conviene uno sin razonamiento:
# la respuesta tiene que llegar en menos de 8 s.
AI_MODEL=""

# Tests E2E (Playwright). Usuarios existentes; los tests son de solo lectura.
# E2E_BASE_URL apunta a un servidor ya levantado; si se omite, se arranca `pnpm dev`.
E2E_BASE_URL=""
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""
E2E_CLIENT_EMAIL=""
E2E_CLIENT_PASSWORD=""
