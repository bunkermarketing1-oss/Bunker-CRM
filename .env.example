# Bunker Agency CRM - Environment Variables

# App Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (SQLite by default, or PostgreSQL for production)
DATABASE_URL="file:./bunker.db"
# Example PostgreSQL for Dokploy / Supabase:
# DATABASE_URL="postgresql://user:password@host:5432/bunker_crm?schema=public"

# Authentication Secret
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# SMS Messaging Provider (Twilio Example)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Meta Integrations (Facebook Pages / Instagram / Ads)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/integrations/meta/callback"

# Google Ads API
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# TikTok Ads API
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# AI Engine (OpenAI / Gemini / Anthropic)
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
