// Bunker Agency CRM - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN") // ADMIN (Bunker), CLIENT (asesor del portal) o CLIENT_OWNER (dueño del cliente: supervisa a sus asesores). Ver src/lib/roles.ts
  clientId     String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  supabaseAuthId String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client       Client?              @relation("ClientPortalUsers", fields: [clientId], references: [id], onDelete: SetNull)
  memberships  OrganizationMember[]
  activities   Activity[]
  tasks        Task[]
  auditLogs    AuditLog[]
  leads        Lead[]               @relation("LeadOwner")
  clients      Client[]             @relation("ClientOwner")
  calls        Call[]
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  plan        String   @default("agency_pro")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members           OrganizationMember[]
  clients           Client[]
  contacts          Contact[]
  leads             Lead[]
  opportunities     Opportunity[]
  pipelineStages    PipelineStage[]
  integrations      Integration[]
  connectedAccounts ConnectedAccount[]
  messages          Message[]
  socialPosts       SocialPost[]
  campaigns         Campaign[]
  automationRules   AutomationRule[]
  auditLogs         AuditLog[]
  metaLeadEvents    MetaLeadEvent[]
  phoneLines        PhoneLine[]
  calls             Call[]
  smsOptOuts        SmsOptOut[]
  aiAssistants      ClientAiAssistant[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Client {
  id             String        @id @default(uuid())
  organizationId String
  ownerId        String?
  name           String
  companyName    String?
  email          String?
  phone          String?
  website        String?
  industry       String?
  logoUrl        String?
  status         String        @default("active") // active, churned, on_hold
  revenue        Float?        @default(0)
  notes          String?
  isDemo         Boolean       @default(false)
  isDeleted      Boolean       @default(false)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?         @relation("ClientOwner", fields: [ownerId], references: [id])
  portalUsers    User[]        @relation("ClientPortalUsers")
  leads          Lead[]
  contacts       Contact[]
  opportunities  Opportunity[]
  activities     Activity[]
  tasks          Task[]
  messages       Message[]
  connectedAccounts ConnectedAccount[]
  automationRules   AutomationRule[]
  phoneLines        PhoneLine[]
  calls             Call[]
  aiAssistant       ClientAiAssistant?
}

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  clientId       String?
  leadId         String?
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  jobTitle       String?
  isPrimary      Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities     Activity[]
  messages       Message[]
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  ownerId        String?
  name           String
  companyName    String?
  email          String?
  phone          String?
  normalizedPhone String?
  avatarUrl      String?      // Foto de perfil del prospecto
  source         String       @default("website") // website, referral, meta_ads, google_ads, manual, etc.
  campaign       String?
  externalLeadId String?
  externalFormId     String? // Formulario de Meta Lead Ads que originó el lead
  externalAdId       String?
  externalCampaignId String?
  smsOptOutAt        DateTime? // Solo para mostrar: la baja vigente vive en SmsOptOut (por número, global)
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  notes          String?
  status         String       @default("new") // new, contacted, qualified, lost, converted
  qualification  Int          @default(0) // 0-100 AI Score
  aiSummary      String?
  estimatedValue Float?       @default(0)
  isDemo         Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contacts       Contact[]
  opportunities  Opportunity[]
  activities     Activity[]
  tasks          Task[]
  messages       Message[]
  metaLeadEvents MetaLeadEvent[]
  calls          Call[]

  // Evita duplicados cuando Meta reintenta el webhook o el cron recupera el mismo lead.
  @@unique([organizationId, externalLeadId])
  @@index([clientId])
  @@index([organizationId])
}

model PipelineStage {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  order          Int           @default(0)
  color          String        @default("#586ff6")
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities  Opportunity[]
}

model Opportunity {
  id             String        @id @default(uuid())
  organizationId String
  stageId        String
  clientId       String?
  leadId         String?
  title          String
  value          Float         @default(0)
  probability    Int           @default(50) // 0-100%
  expectedClose  DateTime?
  status         String        @default("open") // open, won, lost
  isDemo         Boolean       @default(false)
  isDeleted      Boolean       @default(false)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage          PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities     Activity[]
  tasks          Task[]
}

model Activity {
  id             String       @id @default(uuid())
  userId         String?
  clientId       String?
  leadId         String?
  opportunityId  String?
  contactId      String?
  type           String       // call, meeting, email, note, sms
  title          String
  description    String?
  outcome        String?      // completed, cancelled, missed
  performedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  user           User?        @relation(fields: [userId], references: [id])
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
}

model Task {
  id             String       @id @default(uuid())
  userId         String?
  clientId       String?
  leadId         String?
  opportunityId  String?
  title          String
  description    String?
  dueDate        DateTime?
  priority       String       @default("medium") // low, medium, high, urgent
  status         String       @default("pending") // pending, completed, cancelled
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User?        @relation(fields: [userId], references: [id])
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
}

model Integration {
  id             String       @id @default(uuid())
  organizationId String
  provider       String       // meta, google_ads, tiktok, twilio, twitter
  name           String
  description    String?
  status         String       @default("disconnected") // connected, disconnected, pending_credentials, error
  lastSyncAt     DateTime?
  errorMessage   String?
  configJson     String?      // Non-sensitive configs
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedAccounts ConnectedAccount[]
}

model ConnectedAccount {
  id             String       @id @default(uuid())
  organizationId String
  integrationId  String
  clientId       String?      // Cliente al que el admin asignó esta cuenta (lo ve en su portal)
  accountName    String
  accountType    String?      // meta_ad_account, facebook_page, instagram_business, tiktok_advertiser
  externalId     String?
  status         String       @default("active") // active, expired, error
  accessTokenEnc String?      // AES-256-GCM cifrado (src/lib/crypto.ts), nunca se expone al cliente
  tokenExpiresAt DateTime?
  scopes         String?
  metadataJson   String?
  lastSyncAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  socialPosts    SocialPost[]
  campaigns      Campaign[]

  @@unique([integrationId, accountType, externalId])
  @@index([clientId])
}

model Message {
  id             String       @id @default(uuid())
  organizationId String
  clientId       String?
  leadId         String?
  contactId      String?
  channel        String       @default("sms") // sms, whatsapp, email
  direction      String       @default("outbound") // outbound, inbound
  recipient      String
  body           String
  status         String       @default("pending") // pending, sent, delivered, failed, unknown
  providerMsgId  String?      @unique // SID de Twilio: un reintento del webhook no duplica el mensaje
  errorMessage   String?
  deliveredAt    DateTime?
  isDemo         Boolean      @default(false)
  bulkBatchId    String? // Clave del envío masivo que lo generó (idempotencia por lote)
  generatedBy    String? // null = asesor o automatización; "ai" / "ai_handoff" = asistente fuera de horario
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([recipient, createdAt]) // asociar respuestas entrantes al último envío
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([organizationId, clientId, createdAt(sort: Desc)])
  @@index([leadId])
  @@index([organizationId, recipient, createdAt])
  @@index([channel])
  // Un número recibe a lo sumo un SMS por lote, aunque el lote se ejecute dos veces a la vez.
  @@unique([organizationId, bulkBatchId, recipient])
}

// Asistente de IA de un cliente: contesta los SMS de sus leads fuera del horario de
// atención usando solo la base de conocimiento cargada aquí. Uno por cliente.
model ClientAiAssistant {
  id                String       @id @default(uuid())
  organizationId    String
  clientId          String       @unique
  isEnabled         Boolean      @default(false)
  timezone          String       @default("America/Bogota") // IANA
  businessHoursJson String // { mon: { start: "08:00", end: "18:00" } | null, ... }
  knowledgeBase     String       @default("")
  instructions      String? // tono e indicaciones adicionales
  handoffMessage    String // se envía si la IA falla o no está disponible
  maxRepliesPerDay  Int          @default(3) // por conversación, en las últimas 24 h
  updatedById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client            Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Baja de SMS de un número. Es global porque el número de Twilio lo comparten todas las
// organizaciones: quien respondió BAJA no debe recibir SMS de ningún cliente.
model SmsOptOut {
  id             String        @id @default(uuid())
  phone          String        @unique // E.164
  optedOutAt     DateTime      @default(now())
  keyword        String // palabra con la que se dio de baja (normalizada)
  organizationId String? // organización de la conversación donde se pidió (trazabilidad)

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model SocialPost {
  id                 String            @id @default(uuid())
  organizationId     String
  connectedAccountId String?
  content            String
  mediaUrlsJson      String?           // JSON array of image/video URLs
  platformsJson      String?           // ["instagram", "facebook"]
  scheduledFor       DateTime?
  publishedAt        DateTime?
  status             String            @default("draft") // draft, scheduled, in_progress, published, failed
  externalPostId     String?
  errorMessage       String?
  isDemo             Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
}

model Campaign {
  id                 String            @id @default(uuid())
  organizationId     String
  connectedAccountId String?
  externalId         String?           // ID de la campaña en la plataforma
  name               String
  platform           String            // meta_ads, google_ads, tiktok
  objective          String?
  currency           String?
  budget             Float             @default(0)
  budgetType         String?           // daily, lifetime
  spent              Float             @default(0)
  impressions        Int               @default(0)
  reach              Int               @default(0)
  clicks             Int               @default(0)
  conversions        Int               @default(0)
  status             String            @default("active") // active, paused, completed
  startDate          DateTime?
  endDate            DateTime?
  isDemo             Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  metrics            CampaignMetric[]

  @@unique([connectedAccountId, externalId])
}

// Métricas diarias por campaña sincronizadas desde Meta Ads / TikTok Ads
model CampaignMetric {
  id          String   @id @default(uuid())
  campaignId  String
  date        DateTime @db.Date
  spend       Float    @default(0)
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}

model AutomationRule {
  id             String       @id @default(uuid())
  organizationId String
  clientId       String?      // null = aplica a los leads de todos los clientes
  name           String
  triggerEvent   String       // lead_created, status_changed, deal_won
  conditionJson  String?
  actionType     String       // send_sms, assign_agent, notify_slack, create_task
  actionPayload  String?
  isActive       Boolean      @default(true)
  executionCount Int          @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, triggerEvent, isActive])
}

// Número de Twilio registrado en el CRM ("línea"). Las llamadas a leads de un cliente salen
// por su línea; las entrantes a ese número timbran a sus asesores.
model PhoneLine {
  id             String       @id @default(uuid())
  organizationId String
  clientId       String?
  phoneNumber    String       @unique // E.164
  label          String
  recordCalls    Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  calls          Call[]

  @@index([organizationId])
}

// Llamada de voz. Las salientes son una conferencia de Twilio (`conferenceName`) con el
// asesor y el lead, para que un supervisor pueda entrar a escuchar.
model Call {
  id              String       @id @default(uuid())
  organizationId  String
  clientId        String?
  leadId          String?
  userId          String?      // asesor que llamó o contestó
  lineId          String?
  direction       String       // outbound, inbound
  fromNumber      String
  toNumber        String
  status          String       @default("initiated") // initiated, ringing, in_progress, completed, busy, no_answer, failed, canceled
  conferenceName  String?      @unique
  agentCallSid    String?      // pierna del asesor (navegador)
  customerCallSid String?      // pierna del lead
  durationSec     Int?
  recordingSid    String?
  recordingUrl    String?
  answeredAt      DateTime?
  endedAt         DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  line            PhoneLine?   @relation(fields: [lineId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([customerCallSid])
  @@index([agentCallSid])
}

// Evento `leadgen` recibido de Meta (webhook o recuperado por el cron). Se guarda antes de
// procesarlo para poder reintentar los que fallen y auditar lo que mandó Meta.
model MetaLeadEvent {
  id             String        @id @default(uuid())
  organizationId String?       // null si la página no está conectada a ninguna organización
  leadgenId      String        @unique
  pageId         String
  formId         String?
  adId           String?
  payloadJson    String
  status         String        @default("received") // received, processed, failed, ignored
  attempts       Int           @default(0)
  errorMessage   String?
  leadId         String?
  processedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([status])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  detailsJson    String?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
}
