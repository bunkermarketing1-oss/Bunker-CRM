// Bunker Agency CRM - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN") // Only two functional roles: ADMIN (Bunker Agency internal), CLIENT (Client commercial portal)
  clientId     String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  supabaseAuthId String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client       Client?              @relation("ClientPortalUsers", fields: [clientId], references: [id], onDelete: SetNull)
  memberships  OrganizationMember[]
  activities   Activity[]
  tasks        Task[]
  auditLogs    AuditLog[]
  leads        Lead[]               @relation("LeadOwner")
  clients      Client[]             @relation("ClientOwner")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  plan        String   @default("agency_pro")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members           OrganizationMember[]
  clients           Client[]
  contacts          Contact[]
  leads             Lead[]
  opportunities     Opportunity[]
  pipelineStages    PipelineStage[]
  integrations      Integration[]
  connectedAccounts ConnectedAccount[]
  messages          Message[]
  socialPosts       SocialPost[]
  campaigns         Campaign[]
  automationRules   AutomationRule[]
  auditLogs         AuditLog[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Client {
  id             String        @id @default(uuid())
  organizationId String
  ownerId        String?
  name           String
  companyName    String?
  email          String?
  phone          String?
  website        String?
  industry       String?
  status         String        @default("active") // active, churned, on_hold
  revenue        Float?        @default(0)
  notes          String?
  isDemo         Boolean       @default(false)
  isDeleted      Boolean       @default(false)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?         @relation("ClientOwner", fields: [ownerId], references: [id])
  portalUsers    User[]        @relation("ClientPortalUsers")
  leads          Lead[]
  contacts       Contact[]
  opportunities  Opportunity[]
  activities     Activity[]
  tasks          Task[]
  messages       Message[]
  connectedAccounts ConnectedAccount[]
}

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  clientId       String?
  leadId         String?
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  jobTitle       String?
  isPrimary      Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities     Activity[]
  messages       Message[]
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  ownerId        String?
  name           String
  companyName    String?
  email          String?
  phone          String?
  normalizedPhone String?
  source         String       @default("website") // website, referral, meta_ads, google_ads, manual, etc.
  campaign       String?
  externalLeadId String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  notes          String?
  status         String       @default("new") // new, contacted, qualified, lost, converted
  qualification  Int          @default(0) // 0-100 AI Score
  aiSummary      String?
  estimatedValue Float?       @default(0)
  isDemo         Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contacts       Contact[]
  opportunities  Opportunity[]
  activities     Activity[]
  tasks          Task[]
  messages       Message[]
}

model PipelineStage {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  order          Int           @default(0)
  color          String        @default("#586ff6")
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities  Opportunity[]
}

model Opportunity {
  id             String        @id @default(uuid())
  organizationId String
  stageId        String
  clientId       String?
  leadId         String?
  title          String
  value          Float         @default(0)
  probability    Int           @default(50) // 0-100%
  expectedClose  DateTime?
  status         String        @default("open") // open, won, lost
  isDemo         Boolean       @default(false)
  isDeleted      Boolean       @default(false)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage          PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities     Activity[]
  tasks          Task[]
}

model Activity {
  id             String       @id @default(uuid())
  userId         String?
  clientId       String?
  leadId         String?
  opportunityId  String?
  contactId      String?
  type           String       // call, meeting, email, note, sms
  title          String
  description    String?
  outcome        String?      // completed, cancelled, missed
  performedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  user           User?        @relation(fields: [userId], references: [id])
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
}

model Task {
  id             String       @id @default(uuid())
  userId         String?
  clientId       String?
  leadId         String?
  opportunityId  String?
  title          String
  description    String?
  dueDate        DateTime?
  priority       String       @default("medium") // low, medium, high, urgent
  status         String       @default("pending") // pending, completed, cancelled
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User?        @relation(fields: [userId], references: [id])
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
}

model Integration {
  id             String       @id @default(uuid())
  organizationId String
  provider       String       // meta, google_ads, tiktok, twilio, twitter
  name           String
  description    String?
  status         String       @default("disconnected") // connected, disconnected, pending_credentials, error
  lastSyncAt     DateTime?
  errorMessage   String?
  configJson     String?      // Non-sensitive configs
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedAccounts ConnectedAccount[]
}

model ConnectedAccount {
  id             String       @id @default(uuid())
  organizationId String
  integrationId  String
  accountName    String
  accountType    String?      // meta_ad_account, facebook_page, instagram_business, tiktok_advertiser
  externalId     String?
  status         String       @default("active") // active, expired, error
  accessTokenEnc String?      // AES-256-GCM cifrado (src/lib/crypto.ts), nunca se expone al cliente
  tokenExpiresAt DateTime?
  scopes         String?
  metadataJson   String?
  lastSyncAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  socialPosts    SocialPost[]
  campaigns      Campaign[]

  @@unique([integrationId, accountType, externalId])
  @@index([clientId])
}

model Message {
  id             String       @id @default(uuid())
  organizationId String
  clientId       String?
  leadId         String?
  contactId      String?
  channel        String       @default("sms") // sms, whatsapp, email
  direction      String       @default("outbound") // outbound, inbound
  recipient      String
  body           String
  status         String       @default("pending") // pending, sent, delivered, failed, unknown
  providerMsgId  String?
  errorMessage   String?
  deliveredAt    DateTime?
  isDemo         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
}

model SocialPost {
  id                 String            @id @default(uuid())
  organizationId     String
  connectedAccountId String?
  content            String
  mediaUrlsJson      String?           // JSON array of image/video URLs
  platformsJson      String?           // ["instagram", "facebook"]
  scheduledFor       DateTime?
  publishedAt        DateTime?
  status             String            @default("draft") // draft, scheduled, in_progress, published, failed
  externalPostId     String?
  errorMessage       String?
  isDemo             Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
}

model Campaign {
  id                 String            @id @default(uuid())
  organizationId     String
  connectedAccountId String?
  externalId         String?           // ID de la campaña en la plataforma
  name               String
  platform           String            // meta_ads, google_ads, tiktok
  objective          String?
  currency           String?
  budget             Float             @default(0)
  budgetType         String?           // daily, lifetime
  spent              Float             @default(0)
  impressions        Int               @default(0)
  reach              Int               @default(0)
  clicks             Int               @default(0)
  conversions        Int               @default(0)
  status             String            @default("active") // active, paused, completed
  startDate          DateTime?
  endDate            DateTime?
  isDemo             Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  metrics            CampaignMetric[]

  @@unique([connectedAccountId, externalId])
}

// Métricas diarias por campaña sincronizadas desde Meta Ads / TikTok Ads
model CampaignMetric {
  id          String   @id @default(uuid())
  campaignId  String
  date        DateTime @db.Date
  spend       Float    @default(0)
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}

model AutomationRule {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  triggerEvent   String       // lead_created, status_changed, deal_won
  conditionJson  String?
  actionType     String       // send_sms, assign_agent, notify_slack, create_task
  actionPayload  String?
  isActive       Boolean      @default(true)
  executionCount Int          @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  detailsJson    String?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
}
