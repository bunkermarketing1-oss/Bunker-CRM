#!/usr/bin/env sh
# Pre-commit: buenas prácticas antes de cada commit (ver AGENTS.md).
# - Bloquea archivos .env reales (las plantillas *.example sí se permiten)
# - ESLint --fix + typecheck sobre los archivos en stage (lint-staged)
# Los E2E necesitan servidor y navegador: se corren con `pnpm test:e2e`.

# 1) Los .env llevan llaves de producción y nunca deben llegar al repo
blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\..+)?$' | grep -vE '\.example$' || true)
if [ -n "$blocked" ]; then
  echo "Commit bloqueado: estos archivos .env no se deben commitear:" >&2
  echo "$blocked" >&2
  exit 1
fi

# 2) ESLint --fix + typecheck sobre lo que está en stage
pnpm exec lint-staged
